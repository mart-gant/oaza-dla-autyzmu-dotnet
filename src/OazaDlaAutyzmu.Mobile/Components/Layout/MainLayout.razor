@inherits LayoutComponentBase
@inject ApiService Api
@inject NavigationManager Nav
@implements IDisposable

<div class="@GetSensoryClasses() min-h-screen flex flex-col transition-colors duration-300" style="@GetTextStyle()">
    <!-- Top Header -->
    <header class="bg-sky-700 text-white shadow-md px-4 py-3 sticky top-0 z-50 flex items-center justify-between">
        <div class="flex items-center space-x-2">
            <span class="text-2xl">🧩</span>
            <h1 class="text-lg font-bold tracking-tight">Oaza dla Autyzmu</h1>
        </div>
        
        <!-- Sensory Settings Toggle Button -->
        <button @onclick="ToggleSettings" aria-label="Ustawienia sensoryczne i dostępność" 
                class="p-2 rounded-full hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-300 transition-colors clickable-active">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
        </button>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto pb-20 p-4">
        @Body
    </main>

    <!-- Bottom Navigation Bar (Tab Bar) -->
    <nav class="bg-white border-t border-slate-200 fixed bottom-0 left-0 right-0 h-16 flex justify-around items-center z-40 shadow-lg">
        <NavLink href="" Match="NavLinkMatch.All" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-sky-600 transition-colors" ActiveClass="text-sky-600 font-semibold border-t-2 border-sky-600">
            <span class="text-xl">🏠</span>
            <span class="text-xs mt-1">Start</span>
        </NavLink>
        <NavLink href="facilities" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-sky-600 transition-colors" ActiveClass="text-sky-600 font-semibold border-t-2 border-sky-600">
            <span class="text-xl">🏢</span>
            <span class="text-xs mt-1">Placówki</span>
        </NavLink>
        <NavLink href="forum" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-sky-600 transition-colors" ActiveClass="text-sky-600 font-semibold border-t-2 border-sky-600">
            <span class="text-xl">💬</span>
            <span class="text-xs mt-1">Forum</span>
        </NavLink>
        <NavLink href="account" class="flex flex-col items-center justify-center w-full h-full text-slate-500 hover:text-sky-600 transition-colors" ActiveClass="text-sky-600 font-semibold border-t-2 border-sky-600">
            <span class="text-xl">👤</span>
            <span class="text-xs mt-1">@(Api.IsAuthenticated ? "Konto" : "Zaloguj")</span>
        </NavLink>
    </nav>

    <!-- Sensory Settings Overlay Modal -->
    @if (_showSettings)
    {
        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-end justify-center" @onclick="ToggleSettings">
            <div class="bg-white w-full max-w-md rounded-t-2xl p-6 shadow-2xl space-y-6" @onclick:stopPropagation>
                <!-- Modal Header -->
                <div class="flex justify-between items-center border-b pb-3">
                    <h2 class="text-lg font-bold text-slate-900 flex items-center space-x-2">
                        <span>⚙️</span>
                        <span>Panel Udogodnień Sensorycznych</span>
                    </h2>
                    <button @onclick="ToggleSettings" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
                </div>

                <!-- Backend Connection URL (Great UX!) -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-slate-700">Adres Serwera API (Backend):</label>
                    <div class="flex space-x-2">
                        <input type="text" @bind="_backendUrl" class="w-full px-3 py-2 border rounded-md text-sm bg-slate-50 focus:bg-white focus:outline-sky-500" />
                        <button @onclick="SaveBackendUrl" class="px-3 py-2 bg-sky-600 text-white rounded-md text-sm hover:bg-sky-700 transition-colors">Zapisz</button>
                    </div>
                </div>

                <!-- Text Scale Slider -->
                <div class="space-y-2">
                    <div class="flex justify-between text-sm font-medium text-slate-700">
                        <span>Rozmiar tekstu</span>
                        <span class="text-sky-600">@((int)(_textScale * 100))%</span>
                    </div>
                    <input type="range" min="0.8" max="1.5" step="0.1" @bind="_textScale" @bind:after="SaveTextScale"
                           class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-sky-600" />
                </div>

                <!-- Toggles Grid -->
                <div class="grid grid-cols-1 gap-4">
                    <!-- High Contrast -->
                    <label class="flex items-center justify-between p-3 border rounded-xl hover:bg-slate-50 cursor-pointer">
                        <div class="space-y-0.5">
                            <span class="block text-sm font-bold text-slate-950">Wysoki kontrast</span>
                            <span class="block text-xs text-slate-500">Wyraźniejszy tekst i obramowania</span>
                        </div>
                        <input type="checkbox" @bind="_highContrast" @bind:after="SaveHighContrast" class="w-5 h-5 rounded text-sky-600 border-slate-300 focus:ring-sky-500" />
                    </label>

                    <!-- Reduced Motion -->
                    <label class="flex items-center justify-between p-3 border rounded-xl hover:bg-slate-50 cursor-pointer">
                        <div class="space-y-0.5">
                            <span class="block text-sm font-bold text-slate-950">Redukcja ruchu</span>
                            <span class="block text-xs text-slate-500">Wyłączenie animacji i przejść</span>
                        </div>
                        <input type="checkbox" @bind="_reducedMotion" @bind:after="SaveReducedMotion" class="w-5 h-5 rounded text-sky-600 border-slate-300 focus:ring-sky-500" />
                    </label>

                    <!-- Calm Mode -->
                    <label class="flex items-center justify-between p-3 border rounded-xl hover:bg-slate-50 cursor-pointer">
                        <div class="space-y-0.5">
                            <span class="block text-sm font-bold text-slate-950">Tryb spokojny (Ciepłe barwy)</span>
                            <span class="block text-xs text-slate-500">Zmniejsza zmęczenie oczu i bodźce wzrokowe</span>
                        </div>
                        <input type="checkbox" @bind="_calmMode" @bind:after="SaveCalmMode" class="w-5 h-5 rounded text-sky-600 border-slate-300 focus:ring-sky-500" />
                    </label>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _showSettings = false;
    private double _textScale = 1.0;
    private bool _highContrast = false;
    private bool _reducedMotion = false;
    private bool _calmMode = false;
    private string _backendUrl = string.Empty;

    protected override void OnInitialized()
    {
        Api.OnAuthStateChanged += StateHasChanged;
        Api.OnSensorySettingsChanged += LoadSettings;
        LoadSettings();
    }

    private void LoadSettings()
    {
        _textScale = Api.GetTextScale();
        _highContrast = Api.GetHighContrast();
        _reducedMotion = Api.GetReducedMotion();
        _calmMode = Api.GetCalmMode();
        _backendUrl = Api.GetBackendUrl();
        StateHasChanged();
    }

    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
    }

    private void SaveTextScale()
    {
        Api.SetTextScale(_textScale);
    }

    private void SaveHighContrast()
    {
        Api.SetHighContrast(_highContrast);
    }

    private void SaveReducedMotion()
    {
        Api.SetReducedMotion(_reducedMotion);
    }

    private void SaveCalmMode()
    {
        Api.SetCalmMode(_calmMode);
    }

    private void SaveBackendUrl()
    {
        if (!string.IsNullOrWhiteSpace(_backendUrl))
        {
            Api.SetBackendUrl(_backendUrl);
            ToggleSettings();
            Nav.NavigateTo(Nav.Uri, forceLoad: true); // Force reload with new base address
        }
    }

    private string GetSensoryClasses()
    {
        var classes = new List<string>();
        if (_highContrast) classes.Add("sensory-high-contrast");
        if (_reducedMotion) classes.Add("sensory-reduced-motion");
        if (_calmMode) classes.Add("sensory-calm");
        return string.Join(" ", classes);
    }

    private string GetTextStyle()
    {
        return $"font-size: {(_textScale * 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    public void Dispose()
    {
        Api.OnAuthStateChanged -= StateHasChanged;
        Api.OnSensorySettingsChanged -= LoadSettings;
    }
}
